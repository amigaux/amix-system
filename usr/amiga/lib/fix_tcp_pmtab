#!/bin/sh

if [ "$#" != "1" ]
then
	echo "Usage: $0 ip-number"
	exit 1
fi

sed -e "s/\(\x[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]\)[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/\1$1/" \
		< /etc/saf/tcp/_pmtab > /tmp/pm$$

if [ $? = "0" ]
then
	cp /tmp/pm$$ /etc/saf/tcp/_pmtab
fi

rm -f /tmp/pm$$

