#!/bin/sh
#
# mklost+found
#
# Make a lost+found directory.
#

set -e
umask 022

case $# in
1)
	count=10;;
2)
	inodes=`fsinfo -i $2`
	count=`expr \( \( ${inodes} / 100 \) + 31 \) / 32`;;
*)
	echo "Usage: $0 mountpoint [ device ]" >&2
	exit 1
esac

cd $1
[ -d lost+found ] || mkdir lost+found
cd ./lost+found

n=0
while [ ${n} -lt ${count} ]
do
	> a${n} ; > b${n} ; > c${n} ; > d${n} ; > e${n}
	> f${n} ; > g${n} ; > h${n} ; > i${n} ; > j${n}
	> k${n} ; > l${n} ; > m${n} ; > n${n} ; > o${n}
	> p${n} ; > q${n} ; > r${n} ; > s${n} ; > t${n}
	> u${n} ; > v${n} ; > w${n} ; > x${n} ; > y${n}
	> z${n} ; > A${n} ; > B${n} ; > C${n} ; > D${n}
	if [ ${n} -ne 0 ]
	then
		> E${n} ; > F${n}
	fi
	n=`expr ${n} + 1`
done

if [ ${count} -ne 0 ]
then
	rm [a-zA-Z]*
fi
