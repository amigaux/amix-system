#!/sbin/sh
#
# Patchlevel: format_1.2
#

PATH=/sbin:/usr/bin:/usr/sbin:/usr/amiga/bin

PROGRAM="$0"
REPEAT=false
BATCH=false
DONE=false
DEBUG=false

usage()
{
    echo "
usage: $PROGRAM [-r] [-b] [-d] [:N|A:|B:|devicename]
	-r = repeat,
	-b = batch,
	-d = debug,
	:N = 880k format, drive N (default)
	A: = 720k format, drive 0
	B: =1440k format, drive 0 (high density drive required)
" >&2
	
    exit 1
}

while [ $# != 0 -a "$DONE" = false ]
do
    case "$1" in
	-r)
	    REPEAT=on
	    shift
	    ;;

	-b)
	    BATCH=on
	    shift
	    ;;

	-d)
	    DEBUG=on
	    shift
	    ;;

	-\?)
	    usage
	    ;;

	-*)
	    echo "$PROGRAM: invalid option \`$1'." >&2
	    usage
	    ;;

	 *)
	    DONE=true
	    ;;
    esac
done

if [ $# -gt 1 ] ; then
    echo "$PROGRAM: bad argument count." >&2
    usage
fi


if [ $# = 1 ] ; then
    # Device name given
	

    if [ "`expr \"$1\" : ':[0-3]'`" = 2 ] ; then
	# :N given (N = drive number)
	DRIVENUM=`expr "$1" : ':\([0-9]\)'`
	DEVICE="/dev/rdsk/fd${DRIVENUM}f"
	PROMPT="drive fd${DRIVENUM}"
	BS=11k
    elif [ "$1" = 'A:' ] ; then
	# A: given
	DRIVENUM=0
	DEVICE="/dev/rdsk/fd${DRIVENUM}idf"
	PROMPT="drive fd${DRIVENUM}id"
	BS=9k
    elif [ "$1" = 'B:' ] ; then
	# B: given
	DRIVENUM=0
	DEVICE="/dev/rdsk/fd${DRIVENUM}ihf"
	PROMPT="drive fd${DRIVENUM}ih"
	BS=18k
    elif [ "`expr \"$1\" : 'fd[0-9]'`" = 3 ] ; then
	# fdN given
	DEVICE="/dev/rdsk/${1}f"
	PROMPT="drive $1"
	BS=11k
    elif [ "`expr \"$1\" : 'fd[0-9]id'`" = 5 ] ; then
	# fdNid given
	DEVICE="/dev/rdsk/${1}idf"
	PROMPT="drive $1"
	BS=9k
    elif [ "`expr \"$1\" : 'fd[0-9]ih'`" = 5 ] ; then
	# fdNih given
	DEVICE="/dev/rdsk/${1}ihf"
	PROMPT="drive $1"
	BS=18k
    elif [ "`expr \"$1\" : '/.*'`" = 0 -a ! -b "$1" ] ; then
	echo "$PROGRAM: bad device name given: $1" >&2
	exit 1
    else
	# Full device pathname given
	DEVICE="$1"
	PROMPT="device $1"
	BS=11k
    fi
else
    # Default to /dev/rdsk/fd0f
    DEVICE=/dev/rdsk/fd0f
    PROMPT="drive fd0"
    BS=11k
fi

if [ ! -c "$DEVICE" ] ; then
    echo "$PROGRAM: Only raw devices can be formated." >&2
    exit 1
fi

while true
do
    if [ "$DEBUG" = on ] ; then
	echo "
PROGRAM='$PROGRAM'   PROMPT='$PROMPT'   DEBUG='$DEBUG'   BATCH='$BATCH'
REPEAT='$REPEAT'   BS='$BS'   DEVICE='$DEVICE'   DONE='$DONE'"
    fi
    if [ $BATCH = false ] ; then
	echo "Insert disk in $PROMPT and press [Return] or \`q' to Quit: \c"
	read foo

	if [ x"$foo" = xq ] ; then
	    exit 0
	fi
    fi

    dd if=/dev/zero bs="$BS" count=80 of="$DEVICE"

    if [ $REPEAT = false ] ; then
	exit 0
    fi
done
