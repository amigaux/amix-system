all:: unit_test1

unit_test1:  unit_test1.o
	$(RM) $@; if [ -f $@ ]; then $(MV) $@ $@~; fi
	$(CC) -o $@  unit_test1.o $(LDOPTIONS)  $(XOLLIB) $(XTOOLLIB) $(XLIB) $(LDLIBS)  $(SYS_LIBRARIES) $(EXTRA_LOAD_FLAGS)

clean::
	$(RM) unit_test1

