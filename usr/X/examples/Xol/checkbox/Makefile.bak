OBJS = $(SRCS:.c=.o)

DSHAREDOBJS = $(SRCS:.c=.o)

SHAREDOBJS = $(DSHAREDOBJS)

all:: $(XolLIBS_TO_BUILD)

.c.o:
	@if [ -d shared ]; then \
	echo \\t$(CC) -c -fpic $(CFLAGS) $<; \
	$(CC) -c -fpic $(CFLAGS) $<; \
	$(RM) shared/$*.o; \
	echo \\t$(MV) $*.o shared; \
	$(MV) $*.o shared; \
	fi
	$(CC) -c $(CFLAGS) $<

lib$(LIBNAME).so::
	@if [ ! -d shared ]; then \
	mkdir shared; \
	fi
lib$(LIBNAME).so:: $(SHAREDOBJS)
	$(RM) lib$(LIBNAME).so
	cd shared; \
	$(CC) $(YFLAGS) -G $(SHAREDOBJS) -o lib$(LIBNAME).so $(SHLIBFLAGS)
	$(MV) shared/lib$(LIBNAME).so .
	rm -f /usr/lib/libXol.so
	ln -s `pwd`/libXol.so /usr/lib/libXol.so
clean clobber::
	@if [ -d shared ]; then \
	echo \\t$(RM) -rf shared; \
	$(RM) -rf shared; \
	fi

install:: libXol.so
	-rm -f /usr/lib/libXol.so
	-ln -s /usr/X/lib/libXol.so /usr/lib/libXol.so
	$(INSTALL) -c $(INSTLIBFLAGS) libXol.so $(USRLIBDIR)

.PRECIOUS:: lib$(LIBNAME).a

lib$(LIBNAME).a:: $(OBJS)
	ar rv $@ $?

lintlib:: llib-lXol.ln

llib-lXol.ln: $(SRCS)
	$(RM) $@
	$(LINT) $(LINTLIBFLAG)Xol $(LINTFLAGS) $(SRCS)

install::
	$(RM) -rf $(INCROOT)/Xol
	-[ -d $(ATTDESTDIR)/include/Xol ] || mkdir -p $(ATTDESTDIR)/include/Xol
	$(LN) -s $(ATTDESTDIR)/include/Xol $(INCROOT)/Xol

install:: lib$(LIBNAME).a
	-rm -f /usr/lib/lib$(LIBNAME).a
	-ln -s /usr/X/lib/lib$(LIBNAME).a /usr/lib/lib$(LIBNAME).a
	$(INSTALL) -c $(INSTLIBFLAGS) lib$(LIBNAME).a $(USRLIBDIR)
	$(RANLIB) $(RANLIBINSTFLAGS) $(USRLIBDIR)/lib$(LIBNAME).a

install.ln:: llib-lXol.ln
	$(INSTALL) -c $(INSTLIBFLAGS) llib-lXol.ln $(USRLIBDIR)

install::
	-[ -d $(INCROOT)/Xol/bitmaps ] || mkdir -p $(INCROOT)/Xol/bitmaps
	-[ -d $(LIBDIR)/bitmaps ] || mkdir -p $(LIBDIR)/bitmaps
	-[ -d $(LIBDIR)/Xol ] || mkdir -p $(LIBDIR)/Xol
	-[ -d $(LIBDIR)/bitmaps ] || mkdir -p $(LIBDIR)/bitmaps

install:: geometry/?*
	@case '${MFLAGS}' in *[i]*) set +e;; esac; \
	for i in geometry/?*; do \
	(set -x; $(INSTALL) -c $(INSTALLFLAGS) $$i  $(ATTDESTDIR)/include/Xol/bitmaps); \
	done

install:: bitmaps/?*
	@case '${MFLAGS}' in *[i]*) set +e;; esac; \
	for i in bitmaps/?*; do \
	(set -x; $(INSTALL) -c $(INSTALLFLAGS) $$i  $(ATTDESTDIR)/include/Xol/bitmaps); \
	done

install:: bitmaps/?*
	@case '${MFLAGS}' in *[i]*) set +e;; esac; \
	for i in bitmaps/?*; do \
	(set -x; $(INSTALL) -c $(INSTALLFLAGS) $$i  $(LIBDIR)/bitmaps); \
	done

install:: $(HEADERS)
	@case '${MFLAGS}' in *[i]*) set +e;; esac; \
	for i in $(HEADERS); do \
	(set -x; $(INSTALL) -c $(INSTALLFLAGS) $$i $(ATTDESTDIR)/include/Xol); \
	done

depend:: $(DEPEND)

$(DEPEND):
	@echo "checking $@ over in $(DEPENDSRC) first..."; \
	cd $(DEPENDSRC); $(MAKE); \
	echo "okay, continuing in $(CURRENT_DIR)"

depend::
	$(DEPEND) -s "# DO NOT DELETE" -- $(ALLDEFINES) -- $(SRCS)

###########################################################################
# common rules for all Makefiles - do not edit

emptyrule::

clean::
	$(RM_CMD) \#*

Makefile:: $(IMAKE)

$(IMAKE):
	@(cd $(IMAKESRC); if [ -f Makefile ]; then \
	echo "checking $@ in $(IMAKESRC) first..."; $(MAKE) all; else \
	echo "bootstrapping $@ from Makefile.ini in $(IMAKESRC) first..."; \
	$(MAKE) -f Makefile.ini BOOTSTRAPCFLAGS=$(BOOTSTRAPCFLAGS); fi; \
	echo "okay, continuing in $(CURRENT_DIR)")

Makefile::
	-@if [ -f Makefile ]; then \
	echo "	$(RM) Makefile.bak; $(MV) Makefile Makefile.bak"; \
	$(RM) Makefile.bak; $(MV) Makefile Makefile.bak; \
	else exit 0; fi
	$(IMAKE_CMD) -DTOPDIR=$(TOP) -DCURDIR=$(CURRENT_DIR)

tags::
	$(TAGS) -w *.[ch]
	$(TAGS) -xw *.[ch] > TAGS

###########################################################################
# empty rules for directories that do not have SUBDIRS - do not edit

install::
	@echo "install in $(CURRENT_DIR) done"

install.man::
	@echo "install.man in $(CURRENT_DIR) done"

