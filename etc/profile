#ident	"@(#)sadmin:etc/profile	2.3"
#	The profile that all logins get before using their own .profile.

trap ""  2 3
export LOGNAME

. /etc/TIMEZONE

#	Login and -su shells get /etc/profile services.
#	-rsh is given its environment in its .profile.
case "$0" in
"-rsh" | "-rksh" )	;;
* )
	if [ "$DISPLAY" ] ; then
		Xb=":/usr/X/bin"
	else
		Xb=""
	fi
	if [ -w / ]
	then
		PATH=/usr/local/bin:/usr/bin:/usr/ccs/bin:/sbin:/usr/sbin:/etc:/usr/ucb:/usr/amiga/bin:/usr/public/bin:/usr/hosts${Xb}
	else
		PATH=$HOME/bin:/usr/local/bin:/usr/bin:/usr/ccs/bin:/sbin:/usr/sbin:/etc:/usr/ucb:/usr/amiga/bin:/usr/public/bin:/usr/hosts${Xb}:/usr/games:.
	fi
	export PATH TERM

	case "`tty`" in
	/dev/console | /dev/syscon | /dev/systty | /dev/term/con* )
		TERM=amiga
		;;
	esac

	if sioc
	then
		SCREEN_GROUP=`sioc getgroup`; export SCREEN_GROUP
	fi

	stty erase '^H' kill '^U' intr '^C' eof '^D' quit '^\'
	stty iexten echoke echoe echoctl echoprt -istrip tab0

	#	Allow the user to break the Message-Of-The-Day only.
	trap "trap '' 2"  2
	cat -s /etc/motd
	trap "" 2

	test -x /usr/bin/mail && mail -e && echo "you have mail"

	if [ "x${LOGNAME}" != "xroot" ]
	then
		news -n
	fi
	;;
esac

umask 022
trap  2 3
