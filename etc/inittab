#
# Screen characteristics (font, color, etc.) are now in /etc/screendefs
# 
#
# Turn screens on with:   pmadm -e -p screens -s SCREENNAME
# Turn screens off with:  pmadm -d -p screens -s SCREENNAME
# Example:  pmadm -e -p screens -s con9
#
#
# Do NOT add getty entries to /etc/inittab.
# Turn serial port logins on with:       pmadm -e -p serial -s PORTNAME
# 			 off with:       pmadm -d -p serial -s PORTNAME
# Example: Enable the main serial port:  pmadm -e -p serial -s ser
# The seven serial ports on the A2232 card are called ql00 through ql06.
# If necessary change the default 9600M in /etc/saf/serial/_pmtab 
# to match a different /etc/ttydefs baud rate hunt sequence.
