# First Amiga/Ameristar Ethernet board
# (automatically determines if board is in system)
/usr/amiga/bin/aen -S &&
    /usr/sbin/slink addaen /dev/aen0 aen0 &&
	/usr/sbin/ifconfig aen0 `uname -n` up -trailers

